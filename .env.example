APP_NAME=LST_Social
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
BRAND_NAME="Love Straight Talks"
BRAND_PRODUCT_NAME="LST Social"
BRAND_SUPPORT_EMAIL=support@lovestraighttalks.com
BRAND_IOS_APP_URL=https://apps.apple.com/app/your-app-id
BRAND_ANDROID_APP_URL=https://play.google.com/store/apps/details?id=com.fiyinfholuwa.lstsocial

# Required for verified HTTPS links to open directly in the installed mobile app.
# Apple Team ID is the 10-character value shown in the Apple Developer account.
DEEP_LINK_APPLE_TEAM_ID=
DEEP_LINK_APPLE_BUNDLE_ID=com.fiyinfholuwa.lstsocial
# Use the Android application ID and the SHA-256 certificate fingerprint from
# Google Play Console > Setup > App integrity. Separate multiple values with commas.
DEEP_LINK_ANDROID_PACKAGE=com.lstsocial.com
DEEP_LINK_ANDROID_SHA256_FINGERPRINTS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lst_social
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
UPLOAD_DIRECTORY=custom_folder
UPLOAD_URL_PREFIX=/custom_folder
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

BRAND_NAME="Love Straight Talks"
BRAND_PRODUCT_NAME="LST Social"
BRAND_LOGO_URL="https://lovestraighttalks.com/wp-content/uploads/2019/08/0abbb10e-210f-4a45-b10c-854f16c93320.png"
BRAND_SUPPORT_EMAIL="support@lovestraighttalks.com"

VITE_APP_NAME="${APP_NAME}"
