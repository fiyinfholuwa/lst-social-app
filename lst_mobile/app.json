{
  "expo": {
    "name": "LST Social",
    "slug": "lst-social",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "LST Social uses your photos when you choose images to share in a post."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      "expo-audio",
      "expo-video",
      "expo-asset",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand-logo.png",
          "color": "#D62839",
          "defaultChannel": "default"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.fiyinfholuwa.lstsocial",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "LST Social uses your microphone when you choose to record a voice note."
      }
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F7F8FB"
      },
      "package": "com.fiyinfholuwa.lstsocial"
    },
    "extra": {
      "eas": {
        "projectId": "2b054da6-480d-4ddb-97f3-fa0b3bf57298"
      }
    }
  }
}
