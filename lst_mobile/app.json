{
  "expo": {
    "name": "LST Social",
    "slug": "lst-social",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/brand-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "LST Social uses your photos when you choose images to share in a post."
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.fiyinfholuwa.lstsocial",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "LST Social uses your microphone when you choose to record a voice note."
      }
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F7F8FB"
      },
      "package": "com.fiyinfholuwa.lstsocial"
    },
    "extra": {
      "eas": {
        "projectId": "2b054da6-480d-4ddb-97f3-fa0b3bf57298"
      }
    }
  }
}
